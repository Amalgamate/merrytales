generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  VENDOR
  STUDIO
  STAFF
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum EventType {
  WEDDING
  ENGAGEMENT
  ANNIVERSARY
  BIRTHDAY
  BABY_SHOWER
  GRADUATION
  PARTY
  CORPORATE
  OTHER
}

enum VendorStatus {
  DRAFT
  PENDING_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum ComplianceStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  EXPIRED
  REJECTED
}

enum VerificationDocumentType {
  IDENTITY
  BUSINESS_REGISTRATION
  KRA_PIN
  TAX_COMPLIANCE_CERTIFICATE
  ETIMS_PROOF
  COUNTY_BUSINESS_PERMIT
  SECTOR_LICENCE
  BANK_OR_MPESA_PROOF
  ODPC_CERTIFICATE
  INSURANCE
  OTHER
}

enum DocumentReviewStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ListingModerationStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUIRED
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum SubscriptionTier {
  STARTER
  GROWTH
  BUSINESS
  PRO
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  ORDER_RECEIVED
  DESIGNING
  PROOF_READY
  APPROVED
  PRINTING
  QUALITY_CHECK
  READY
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum FulfillmentStatus {
  PENDING
  PREPARING
  READY_FOR_PICKUP
  COURIER_ASSIGNED
  PICKED_UP
  IN_TRANSIT
  ARRIVING
  DELIVERED
  DELIVERY_FAILED
  RETURN_REQUESTED
  RETURNING
  RETURNED
  CANCELLED
}

enum DeliveryMethod {
  COURIER
  VENDOR_DELIVERY
  CUSTOMER_PICKUP
}

enum HandoffMethod {
  PIN
  SIGNATURE
  PHOTO
  IN_PERSON
}

enum VendorQuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

enum ProductionStatus {
  NEW
  STORY_RECEIVED
  CREATIVE_BRIEF
  DESIGNING
  CLIENT_REVIEW
  APPROVED
  PRINTING
  ANIMATION
  QUALITY_CHECK
  DELIVERY
  COMPLETE
}

enum AssetKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

enum OpsThreadType {
  GENERAL
  INCIDENT
  SUPPORT
  VENDOR
  ORDER
}

enum ListingType {
  PRODUCT
  SERVICE
  RENTAL
  PACKAGE
}

enum PriceUnit {
  ITEM
  FIXED
  PERSON
  HOUR
  DAY
  EVENT
  QUOTE
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum CommitmentStatus {
  RESERVED
  RELEASED
  PAID
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
  EQUITY
}

enum LedgerSide {
  DEBIT
  CREDIT
}

model User {
  id                            String                 @id @default(cuid())
  email                         String                 @unique
  phone                         String?                @unique
  passwordHash                  String
  firstName                     String
  lastName                      String
  role                          UserRole               @default(CUSTOMER)
  status                        UserStatus             @default(ACTIVE)
  locale                        String                 @default("en-KE")
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  events                        Event[]
  vendor                        VendorProfile?
  orders                        Order[]
  refreshTokens                 RefreshToken[]
  sentMessages                  Message[]
  notifications                 Notification[]
  assets                        Asset[]
  auditLogs                     AuditLog[]
  reviewedVerificationDocuments VerificationDocument[] @relation("VerificationDocumentReviewer")
  moderatedProducts             Product[]              @relation("ProductModerator")
  createdQuotes                 Quote[]                @relation("QuoteCreator")
  requestedApprovals            ApprovalRequest[]      @relation("ApprovalRequestedBy")
  approvalDecisions             ApprovalRequest[]      @relation("ApprovalDecisionBy")
  authoredVendorQuotes          VendorQuote[]          @relation("VendorQuoteAuthor")
  opsMessages                   OpsMessage[]
  opsParticipants               OpsParticipant[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Event {
  id                String             @id @default(cuid())
  ownerId           String
  type              EventType          @default(WEDDING)
  title             String
  slug              String             @unique
  partnerOne        String?
  partnerTwo        String?
  eventDate         DateTime?
  venue             String?
  city              String?
  countryCode       String             @default("KE")
  currency          String             @default("KES")
  budget            Decimal?           @db.Decimal(12, 2)
  guestTarget       Int?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  owner             User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  guests            Guest[]
  budgetEnvelopes   BudgetEnvelope[]
  quotes            Quote[]
  commitments       BudgetCommitment[]
  approvalRequests  ApprovalRequest[]
  financialAccounts FinancialAccount[]
  ledgerJournals    LedgerJournal[]

  @@index([ownerId])
}

model Guest {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  phone     String?
  email     String?
  household String?
  attending Boolean?
  plusOnes  Int      @default(0)
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model VendorProfile {
  id                         String                 @id @default(cuid())
  ownerId                    String                 @unique
  businessName               String
  slug                       String                 @unique
  category                   String
  description                String?
  city                       String
  countryCode                String                 @default("KE")
  whatsapp                   String?
  startingPrice              Decimal?               @db.Decimal(12, 2)
  currency                   String                 @default("KES")
  status                     VendorStatus           @default(DRAFT)
  kraPin                     String?                @unique
  businessRegistrationNumber String?
  taxComplianceStatus        ComplianceStatus       @default(NOT_SUBMITTED)
  taxComplianceExpiresAt     DateTime?
  etimsStatus                ComplianceStatus       @default(NOT_SUBMITTED)
  verifiedAt                 DateTime?
  verificationNotes          String?
  subscriptionTier           SubscriptionTier       @default(STARTER)
  subscriptionStatus         SubscriptionStatus     @default(PENDING_PAYMENT)
  subscriptionEndsAt         DateTime?
  responseMinutes            Int?
  rating                     Decimal                @default(0) @db.Decimal(2, 1)
  reviewCount                Int                    @default(0)
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  owner                      User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  services                   VendorService[]
  leads                      Lead[]
  reviews                    Review[]
  products                   Product[]
  smsConnection              VendorSmsConnection?
  verificationDocuments      VerificationDocument[]
  subscriptions              VendorSubscription[]
  quotes                     Quote[]
  fulfillments               Fulfillment[]
  commercialQuotes           VendorQuote[]
  invoices                   Invoice[]

  @@index([category, city, status])
}

model VerificationDocument {
  id              String                   @id @default(cuid())
  vendorId        String
  type            VerificationDocumentType
  referenceNumber String?
  fileUrl         String
  issuedAt        DateTime?
  expiresAt       DateTime?
  status          DocumentReviewStatus     @default(PENDING)
  reviewNotes     String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  vendor          VendorProfile            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  reviewedBy      User?                    @relation("VerificationDocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([vendorId, type, status])
  @@index([status, expiresAt])
}

model VendorSubscription {
  id               String             @id @default(cuid())
  vendorId         String
  tier             SubscriptionTier
  status           SubscriptionStatus @default(PENDING_PAYMENT)
  priceKes         Decimal            @db.Decimal(12, 2)
  startsAt         DateTime?
  endsAt           DateTime?
  paymentReference String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  vendor           VendorProfile      @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, status])
}

model VendorSmsConnection {
  id                   String        @id @default(cuid())
  vendorId             String        @unique
  encryptedApiToken    String
  tokenLastFour        String
  senderId             String
  status               String        @default("CONNECTED")
  lastTestedAt         DateTime?
  lastSuccessfulSendAt DateTime?
  lastError            String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  vendor               VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([status])
}

model VendorService {
  id          String        @id @default(cuid())
  vendorId    String
  name        String
  description String?
  price       Decimal?      @db.Decimal(12, 2)
  currency    String        @default("KES")
  vendor      VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model Product {
  id               String                  @id @default(cuid())
  name             String
  slug             String                  @unique
  description      String?
  category         String
  price            Decimal                 @db.Decimal(12, 2)
  vendorId         String?
  listingType      ListingType             @default(PRODUCT)
  priceUnit        PriceUnit               @default(ITEM)
  stockQuantity    Int?
  minimumOrder     Int                     @default(1)
  maximumOrder     Int?
  leadTimeDays     Int                     @default(0)
  serviceArea      String?
  depositAmount    Decimal?                @db.Decimal(12, 2)
  terms            String?
  currency         String                  @default("KES")
  isDigital        Boolean                 @default(false)
  isActive         Boolean                 @default(true)
  moderationStatus ListingModerationStatus @default(DRAFT)
  moderationReason String?
  submittedAt      DateTime?
  approvedAt       DateTime?
  moderatedById    String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  orderItems       OrderItem[]
  vendor           VendorProfile?          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  availability     ListingAvailability[]
  moderatedBy      User?                   @relation("ProductModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@index([category, isActive])
  @@index([moderationStatus, submittedAt])
  @@index([vendorId, listingType, isActive])
}

model ListingAvailability {
  id          String   @id @default(cuid())
  productId   String
  startsAt    DateTime
  endsAt      DateTime
  isAvailable Boolean  @default(false)
  note        String?
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, startsAt, endsAt])
}

model Order {
  id             String          @id @default(cuid())
  customerId     String
  orderNumber    String          @unique
  status         OrderStatus     @default(PENDING_PAYMENT)
  paymentStatus  PaymentStatus   @default(PENDING)
  currency       String          @default("KES")
  subtotal       Decimal         @db.Decimal(12, 2)
  deliveryFee    Decimal         @default(0) @db.Decimal(12, 2)
  total          Decimal         @db.Decimal(12, 2)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  customer       User            @relation(fields: [customerId], references: [id])
  items          OrderItem[]
  payments       Payment[]
  productionJobs ProductionJob[]
  fulfillments   Fulfillment[]

  @@index([customerId, createdAt])
}

model Lead {
  id           String        @id @default(cuid())
  vendorId     String
  customerId   String?
  name         String
  email        String?
  phone        String?
  eventDate    DateTime?
  message      String
  status       LeadStatus    @default(NEW)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  vendor       VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  conversation Conversation?

  @@index([vendorId, status, createdAt])
}

model Conversation {
  id        String    @id @default(cuid())
  leadId    String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model Review {
  id         String        @id @default(cuid())
  vendorId   String
  authorName String
  rating     Int
  body       String?
  verified   Boolean       @default(false)
  createdAt  DateTime      @default(now())
  vendor     VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, createdAt])
}

model Asset {
  id        String    @id @default(cuid())
  ownerId   String
  kind      AssetKind
  key       String    @unique
  url       String
  mimeType  String
  size      Int
  createdAt DateTime  @default(now())
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String
  providerReference String?       @unique
  phone             String?
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("KES")
  status            PaymentStatus @default(PENDING)
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
}

model ProductionJob {
  id        String           @id @default(cuid())
  orderId   String
  title     String
  status    ProductionStatus @default(NEW)
  dueAt     DateTime?
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  channel   NotificationChannel  @default(IN_APP)
  category  String               @default("GENERAL")
  severity  NotificationSeverity @default(INFO)
  title     String
  body      String
  actionUrl String?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime             @default(now())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model OpsThread {
  id           String           @id @default(cuid())
  type         OpsThreadType    @default(GENERAL)
  title        String
  entityType   String?
  entityId     String?
  isClosed     Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  participants OpsParticipant[]
  messages     OpsMessage[]

  @@index([updatedAt])
  @@index([entityType, entityId])
}

model OpsParticipant {
  id         String    @id @default(cuid())
  threadId   String
  userId     String
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())
  thread     OpsThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
}

model OpsMessage {
  id        String    @id @default(cuid())
  threadId  String
  senderId  String
  body      String
  createdAt DateTime  @default(now())
  thread    OpsThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [senderId], references: [id])

  @@index([threadId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
}

model SystemSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id            String       @id @default(cuid())
  orderId       String
  productId     String
  fulfillmentId String?
  name          String
  quantity      Int
  unitPrice     Decimal      @db.Decimal(12, 2)
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product      @relation(fields: [productId], references: [id])
  fulfillment   Fulfillment? @relation(fields: [fulfillmentId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Fulfillment {
  id                String             @id @default(cuid())
  orderId           String
  vendorId          String?
  trackingCode      String             @unique
  status            FulfillmentStatus  @default(PENDING)
  method            DeliveryMethod     @default(COURIER)
  handoffMethod     HandoffMethod      @default(PIN)
  recipientName     String
  recipientPhone    String
  recipientEmail    String?
  county            String
  addressLine       String
  landmark          String?
  instructions      String?
  deliveryPin       String?
  estimatedStart    DateTime?
  estimatedEnd      DateTime?
  courierName       String?
  courierPhone      String?
  courierProvider   String?
  providerReference String?
  trackingUrl       String?
  proofUrl          String?
  deliveredAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor            VendorProfile?     @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  events            FulfillmentEvent[]

  @@index([orderId, status])
  @@index([vendorId, status, createdAt])
}

model FulfillmentEvent {
  id            String            @id @default(cuid())
  fulfillmentId String
  status        FulfillmentStatus
  label         String
  detail        String?
  location      String?
  occurredAt    DateTime          @default(now())
  createdById   String?
  fulfillment   Fulfillment       @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)

  @@index([fulfillmentId, occurredAt])
}

model VendorQuote {
  id             String            @id @default(cuid())
  vendorId       String
  createdById    String
  customerId     String?
  quoteNumber    String            @unique
  reviewToken    String            @unique
  clientName     String
  clientPhone    String
  clientEmail    String?
  title          String
  status         VendorQuoteStatus @default(DRAFT)
  currency       String            @default("KES")
  subtotal       Decimal           @db.Decimal(14, 2)
  taxAmount      Decimal           @default(0) @db.Decimal(14, 2)
  discountAmount Decimal           @default(0) @db.Decimal(14, 2)
  total          Decimal           @db.Decimal(14, 2)
  depositAmount  Decimal?          @db.Decimal(14, 2)
  notes          String?
  terms          String?
  validUntil     DateTime?
  sentAt         DateTime?
  viewedAt       DateTime?
  acceptedAt     DateTime?
  declinedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  vendor         VendorProfile     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdBy      User              @relation("VendorQuoteAuthor", fields: [createdById], references: [id])
  lines          VendorQuoteLine[]
  invoice        Invoice?

  @@index([vendorId, status, createdAt])
  @@index([customerId])
}

model VendorQuoteLine {
  id          String      @id @default(cuid())
  quoteId     String
  description String
  quantity    Decimal     @db.Decimal(12, 2)
  unitPrice   Decimal     @db.Decimal(14, 2)
  taxRate     Decimal     @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal     @db.Decimal(14, 2)
  sortOrder   Int         @default(0)
  quote       VendorQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, sortOrder])
}

model Invoice {
  id            String        @id @default(cuid())
  vendorId      String
  quoteId       String?       @unique
  invoiceNumber String        @unique
  status        InvoiceStatus @default(DRAFT)
  currency      String        @default("KES")
  subtotal      Decimal       @db.Decimal(14, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(14, 2)
  total         Decimal       @db.Decimal(14, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(14, 2)
  balanceDue    Decimal       @db.Decimal(14, 2)
  dueAt         DateTime?
  sentAt        DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  vendor        VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  quote         VendorQuote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([vendorId, status, createdAt])
}

model BudgetEnvelope {
  id              String             @id @default(cuid())
  eventId         String
  name            String
  allocatedAmount Decimal            @db.Decimal(14, 2)
  currency        String             @default("KES")
  color           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  event           Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  commitments     BudgetCommitment[]

  @@unique([eventId, name])
  @@index([eventId])
}

model Quote {
  id            String            @id @default(cuid())
  eventId       String
  vendorId      String?
  createdById   String
  quoteNumber   String            @unique
  title         String
  version       Int               @default(1)
  status        QuoteStatus       @default(DRAFT)
  currency      String            @default("KES")
  subtotal      Decimal           @db.Decimal(14, 2)
  taxAmount     Decimal           @default(0) @db.Decimal(14, 2)
  total         Decimal           @db.Decimal(14, 2)
  depositAmount Decimal?          @db.Decimal(14, 2)
  validUntil    DateTime?
  notes         String?
  acceptedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendor        VendorProfile?    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  createdBy     User              @relation("QuoteCreator", fields: [createdById], references: [id])
  lines         QuoteLine[]
  commitment    BudgetCommitment?

  @@index([eventId, status, createdAt])
  @@index([vendorId])
}

model QuoteLine {
  id          String  @id @default(cuid())
  quoteId     String
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(14, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(14, 2)
  sortOrder   Int     @default(0)
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, sortOrder])
}

model BudgetCommitment {
  id               String            @id @default(cuid())
  eventId          String
  envelopeId       String?
  quoteId          String?           @unique
  description      String
  amount           Decimal           @db.Decimal(14, 2)
  currency         String            @default("KES")
  status           CommitmentStatus  @default(RESERVED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  envelope         BudgetEnvelope?   @relation(fields: [envelopeId], references: [id], onDelete: SetNull)
  quote            Quote?            @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  approvalRequests ApprovalRequest[]

  @@index([eventId, status])
  @@index([envelopeId])
}

model ApprovalRequest {
  id            String            @id @default(cuid())
  eventId       String
  commitmentId  String?
  requestedById String
  decidedById   String?
  purpose       String
  amount        Decimal           @db.Decimal(14, 2)
  currency      String            @default("KES")
  status        ApprovalStatus    @default(PENDING)
  note          String?
  decidedAt     DateTime?
  createdAt     DateTime          @default(now())
  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  commitment    BudgetCommitment? @relation(fields: [commitmentId], references: [id], onDelete: SetNull)
  requestedBy   User              @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  decidedBy     User?             @relation("ApprovalDecisionBy", fields: [decidedById], references: [id])

  @@index([eventId, status, createdAt])
}

model FinancialAccount {
  id        String            @id @default(cuid())
  eventId   String
  code      String
  name      String
  type      LedgerAccountType
  currency  String            @default("KES")
  createdAt DateTime          @default(now())
  event     Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  postings  LedgerPosting[]

  @@unique([eventId, code, currency])
  @@index([eventId, type])
}

model LedgerJournal {
  id             String          @id @default(cuid())
  eventId        String
  reference      String          @unique
  description    String
  sourceType     String
  sourceId       String?
  idempotencyKey String          @unique
  occurredAt     DateTime        @default(now())
  createdAt      DateTime        @default(now())
  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  postings       LedgerPosting[]

  @@index([eventId, occurredAt])
  @@index([sourceType, sourceId])
}

model LedgerPosting {
  id        String           @id @default(cuid())
  journalId String
  accountId String
  side      LedgerSide
  amount    Decimal          @db.Decimal(14, 2)
  currency  String
  createdAt DateTime         @default(now())
  journal   LedgerJournal    @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account   FinancialAccount @relation(fields: [accountId], references: [id])

  @@index([journalId])
  @@index([accountId, createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("WEBSITE_POPUP")
  status    String   @default("PENDING")
  confirmToken String @unique
  unsubscribeToken String @unique
  consentAt DateTime @default(now())
  confirmedAt DateTime?
  unsubscribedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}
