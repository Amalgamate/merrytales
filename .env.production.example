# Copy this file to .env on the server and replace every CHANGE_ME value.
POSTGRES_DB=merrytales
POSTGRES_USER=merrytales
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS

# Public origin served by the host reverse proxy. Do not add a trailing slash.
WEB_ORIGIN=https://merrytales.co.ke
MERRYTALES_HTTP_PORT=8080

MPESA_ENV=sandbox

# Add optional integration variables only after credentials are issued.
# MPESA_CONSUMER_KEY=...
# MPESA_CONSUMER_SECRET=...
# MPESA_SHORTCODE=...
# MPESA_PASSKEY=...
# MPESA_CALLBACK_URL=https://merrytales.co.ke/api/payments/mpesa/callback
# MOBILESASA_ENCRYPTION_KEY=AT_LEAST_32_RANDOM_CHARACTERS
